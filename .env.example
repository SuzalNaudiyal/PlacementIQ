# ==============================================================================
# HireMatrix AI - Placement & Skill Gap Analyzer - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="HireMatrix AI - Placement & Skill Gap Analyzer"
APP_ENV=development
DEBUG=True
VERSION=1.0.0
API_V1_PREFIX=/api
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# MongoDB Database Configuration
# Local: mongodb://localhost:27017
# Docker Compose: mongodb://mongo:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="placement_predictor_db"
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2500

# Authentication & JWT Security
JWT_SECRET_KEY="super-secret-jwt-key-replace-with-secure-random-token-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Policies
MAX_UPLOAD_SIZE_MB=10

# Frontend Configuration
VITE_API_URL="http://localhost:8000/api"
